{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://veilops.io/schemas/v1/policy.schema.json",
  "title": "VeilOpsTenantPolicy",
  "description": "Per-tenant signed data policy governing permissible metrics, severities, and rates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "policy_v", "allowed_metrics", "allowed_severities", "max_fingerprints_per_window", "salt_rotation_interval_days"],
  "properties": {
    "tenant_id": {
      "type": "string",
      "pattern": "^t_[a-z0-9_-]{2,32}$"
    },
    "policy_v": {
      "type": "integer",
      "minimum": 1
    },
    "allowed_metrics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowed_severities": {
      "type": "array",
      "items": { "type": "string", "enum": ["debug", "info", "warn", "error", "critical"] }
    },
    "max_fingerprints_per_window": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50000
    },
    "salt_rotation_interval_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    }
  }
}
